# Isolated NIJA Trading IQ staging image. This is not the trading bot image.
# Node executes the existing published report formulas; Python hosts the
# explicitly disabled-by-default, sandbox-only Stripe API.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates gosu \
 && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 10001 nija \
 && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin nija
WORKDIR /app
COPY requirements.txt /tmp/nija-iq72-requirements.txt
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/nija-iq72-requirements.txt
COPY . /app/game_sandbox/
RUN chmod 755 /app/game_sandbox/staging_start.sh \
 && mkdir -p /var/data \
 && chown -R nija:nija /app /var/data
ENV PYTHONUNBUFFERED=1
EXPOSE 10000
CMD ["/app/game_sandbox/staging_start.sh"]
