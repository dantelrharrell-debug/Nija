[Unit]
Description=NIJA Status Alerts Check
After=network.target

[Service]
Type=oneshot
User=nija
WorkingDirectory=/opt/nija
# Provision this root-owned mode-0600 file before starting the optional monitor.
EnvironmentFile=/etc/nija/monitoring.env
ExecStart=/usr/bin/python3 /opt/nija/status_alerts.py
