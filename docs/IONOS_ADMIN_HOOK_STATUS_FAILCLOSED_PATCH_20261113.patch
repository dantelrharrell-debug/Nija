+// Private dispatcher status is unknown on auth, network or malformed reads — never report "off" or "not configured".
+export function verifiedHookStatus(reply) {
+  if (!reply || typeof reply.endpoint_configured !== "boolean" ||
+      typeof reply.enabled !== "boolean" || typeof reply.activated !== "boolean") {
+    return { loaded: true, configured: null, enabled: null, activated: null, error: "unavailable" };
+  }
+  return { loaded: true, configured: reply.endpoint_configured, enabled: reply.enabled, activated: reply.activated, error: null };
+}
