# REVIEW ONLY: separate education staging image, no broker or billing runtime.
# No payment API, IONOS private source, credentials, or customer data.
FROM node:22-bookworm-slim
RUN groupadd --system --gid 10001 nija-education \
 && useradd --system --uid 10001 --gid 10001 --no-create-home --home-dir /app --shell /usr/sbin/nologin nija-education \
 && mkdir -p /app/server /var/data \
 && chown -R 10001:10001 /app /var/data \
 && chmod 700 /var/data
WORKDIR /app
COPY --chown=10001:10001 server/tiq12-education-staging.mjs server/tiq12-education-start.mjs ./server/
USER 10001:10001
ENV NODE_ENV=production
EXPOSE 10000
CMD ["node", "server/tiq12-education-start.mjs"]
