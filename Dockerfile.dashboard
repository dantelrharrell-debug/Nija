# Dockerfile for NIJA Founder Dashboard
# Security review candidate: OCI base digest resolved by all four 2026-11-15 CI builds; NOT release approved.
ARG PYTHON_BASE=python:3.11-slim-trixie@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
FROM ${PYTHON_BASE} AS deps-builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

FROM ${PYTHON_BASE}
ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /app
# The Python base includes an older global setuptools vendoring
# jaraco.context 5.3.0 (CVE-2026-23949). The app virtualenv does not
# replace base-global metadata. Upgrade only the runtime packaging library
# to the same audited setuptools pin already in requirements.txt.
RUN /usr/local/bin/python -m pip install --no-cache-dir --disable-pip-version-check "setuptools==84.1.0" \
    && /usr/local/bin/python -c "import importlib.metadata as m; assert m.version('setuptools') == '84.1.0'" \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info/METADATA \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info/METADATA
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*
COPY --from=deps-builder /opt/venv /opt/venv

# Copy application code
COPY . .

# Match the Kubernetes pod identity and keep centralized log files writable.
RUN groupadd --gid 10001 dashboard && \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin dashboard && \
    mkdir -p /app/logs && \
    chown dashboard:dashboard /app/logs

# Expose port
EXPOSE 5001

# Set environment variables
ENV PORT=5001
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:5001/api/health', timeout=3)" || exit 1

# Run dashboard
USER dashboard
CMD ["python", "founder_dashboard.py"]
