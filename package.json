{
  "name": "nija-mobile",
  "version": "1.0.0",
  "description": "NIJA AI Trading Platform - Mobile App",
  "author": "NIJA Team",
  "license": "MIT",
  "scripts": {
    "build:web": "python3 scripts/build_mobile_web.py",
    "cap:init": "npx cap init",
    "cap:add:ios": "npm run build:web && npx cap add ios",
    "cap:add:android": "npm run build:web && npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:update": "npx cap update",
    "ios:build": "npm run cap:sync && npx cap open ios",
    "android:build": "npm run cap:sync && npx cap open android",
    "mobile:preflight": "python3 tests/test_mobile_web_bundle.py && python3 scripts/build_mobile_web.py"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.7.0",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@capacitor/splash-screen": "^5.0.6",
    "@capacitor/push-notifications": "^5.1.0",
    "@capacitor/network": "^5.0.6",
    "@capacitor/device": "^5.0.6",
    "@capacitor/browser": "^5.1.0",
    "@capacitor-community/in-app-purchases": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0"
  }
}
