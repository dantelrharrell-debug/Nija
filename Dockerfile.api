# Dockerfile for NIJA FastAPI Backend
# Security review candidate: OCI base digest resolved by all four 2026-11-15 CI builds; NOT release approved.
ARG PYTHON_BASE=python:3.11-slim-trixie@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
FROM ${PYTHON_BASE} AS deps-builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libpq-dev && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

FROM ${PYTHON_BASE}

# Patch the base Python environment as well as the application virtualenv.
# Fail the build if either vulnerable vendored distribution is still present.
RUN /usr/local/bin/python -m pip install --no-cache-dir --disable-pip-version-check "setuptools==84.1.0" \
    && /usr/local/bin/python -c "import importlib.metadata as m; assert m.version('setuptools') == '84.1.0'" \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info/METADATA \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info/METADATA
ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends libpq5 curl && rm -rf /var/lib/apt/lists/*
COPY --from=deps-builder /opt/venv /opt/venv

# Copy application code
COPY . .

# Create non-root user for security
RUN useradd -m -u 1000 nija && chown -R nija:nija /app
USER nija

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Startup script to handle database initialization
COPY --chown=nija:nija docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Run with entrypoint for database initialization
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Default command: Run mobile backend server with Socket.IO support
# For WebSocket support, use eventlet worker
CMD ["gunicorn", "mobile_backend_server:app", "--bind", "0.0.0.0:8000", "--workers", "1", "--worker-class", "eventlet", "--timeout", "120"]
