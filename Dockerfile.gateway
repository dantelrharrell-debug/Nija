# Dockerfile for NIJA API Gateway (not the trading bot)
# REVIEW CANDIDATE ONLY (2026-11-27): Bookworm Python 3.11, immutable Docker Hub index digest.
# Not release approved: requires full image scan, functional validation and independent approval.
ARG PYTHON_BASE=python:3.11-slim-bookworm@sha256:ef56ae98435cc40d8a27020b0b32a9941515acd5840f0fba34858bb34dd362d1
FROM ${PYTHON_BASE} AS deps-builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

FROM ${PYTHON_BASE}

# Patch the base Python environment as well as the application virtualenv.
# Fail the build if either vulnerable vendored distribution is still present.
RUN /usr/local/bin/python -m pip install --no-cache-dir --disable-pip-version-check "setuptools==84.1.0" \
    && /usr/local/bin/python -c "import importlib.metadata as m; assert m.version('setuptools') == '84.1.0'" \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info/METADATA \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info/METADATA
ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /app
# Base-global setuptools bundles vulnerable jaraco.context and wheel metadata
# independent of the isolated application venv. Install the existing reviewed
# setuptools pin and reject an image still containing either vulnerable vendor.
RUN /usr/local/bin/python -m pip install --no-cache-dir --disable-pip-version-check "setuptools==84.1.0" \
    && /usr/local/bin/python -c "import importlib.metadata as m; assert m.version('setuptools') == '84.1.0'" \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info/METADATA \
    && test ! -e /usr/local/lib/python3.11/site-packages/setuptools/_vendor/wheel-0.45.1.dist-info/METADATA
# Gateway uses the Redis client library, not redis-cli. Omit redis-tools.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY --from=deps-builder /opt/venv /opt/venv

# Copy only necessary files for API Gateway
COPY api_gateway.py .
COPY auth/ ./auth/
COPY execution/ ./execution/
COPY user_control.py .
COPY vault/ ./vault/
COPY admin_access.py admin_access_fastapi.py user_live_trading_access.py ./
COPY web_cors_policy.py billing_store.py paid_user_state.py ./
COPY bot/position_source_constants.py ./
# Namespace package containing Redis helpers only; omit trading startup hooks.
COPY bot/redis_runtime.py bot/redis_env.py bot/startup_env.py ./bot/

# Authentication state must be mounted persistently here before production use.
# No startup copy/migration from a legacy users.db is performed.
RUN groupadd --gid 10001 nija-gateway \
    && useradd --uid 10001 --gid 10001 --no-create-home nija-gateway \
    && install -d -m 0700 -o 10001 -g 10001 /data/auth

# Expose port
EXPOSE 8000

# Set environment variables
ENV PORT=8000
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
# Public filesystem path only; contains no credential or authentication token.
# trivy:ignore:DS-0031
ENV NIJA_AUTH_USER_DB_PATH=/data/auth/users.db

USER 10001:10001

# Run API Gateway
CMD ["python", "api_gateway.py"]
